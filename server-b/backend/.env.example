PROJECT_NAME="Avatar Forge Backend"
DATABASE_URL=sqlite+aiosqlite:///./avatar_forge.db
SECRET_KEY=CHANGE_THIS_SECRET_KEY
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
SHARED_MODELS_DIR=./shared_models_mock
USER_ASSETS_DIR=./user_assets_mock
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================
# Server A API 서비스 설정
# ============================================
# 각 API마다 별도의 URL을 설정합니다.
# NPM(Nginx Proxy Manager)을 통한 접근 시: https://도메인
# 직접 접근 시: http://server-a-ip:포트

# LLM 서비스 선택
# "vllm" 또는 "ollama" 중 선택 (동시 실행 불가, VRAM 제약)
LLM_SERVICE=ollama

# vLLM API 설정 (OpenAI 호환 API)
# 엔드포인트: /v1/chat/completions
# NPM 프록시 예시: https://llm.server-a.local
# 직접 접근 예시: http://192.168.1.100:8002
# VLLM_BASE_URL=http://localhost:8002

# Ollama API 설정
# 엔드포인트: /api/chat
# NPM 프록시 예시: https://ollama.server-a.local
# 직접 접근 예시: http://192.168.1.100:11434
OLLAMA_BASE_URL=http://gpugpt.duckdns.org

# GPT-SoVITS TTS API 설정 (api_v2.py)
# 엔드포인트: /tts (POST/GET)
# NPM 프록시 예시: https://tts.server-a.local
# 직접 접근 예시: http://192.168.1.100:9880
# ⚠️ 주의: webui.py의 포트 9872가 아닌 api_v2.py의 포트 9880을 사용합니다
TTS_BASE_URL=http://gpusovitsapi.duckdns.org/
TTS_API_PATH=tts
TTS_TIMEOUT=120.0
TTS_MAX_TEXT_LENGTH=10000
TTS_MAX_FILE_SIZE=52428800
TTS_SSL_VERIFY=false

# BLOCK_NONE
# BLOCK_ONLY_HIGH
# BLOCK_MEDIUM_AND_ABOVE
# BLOCK_LOW_AND_ABOVE
# HARM_BLOCK_THRESHOLD_UNSPECIFIED
# BLOCK_NONE은 어떤 위해성있는 문장도 거르지 않겠다. 이고, BLOCK_LOW_AND_ABOVE는 조금이라도 위해성이 있으면 거르겠다. 라고 이해하면 된다. HARM_BLOCK_THRESHOLD_UNSPECIFIED은 기본값이다.
GOOGLE_SAFETY_THRESHOLD=BLOCK_NONE

# Server A (GPT-SoVITS 서버) 파일 관리 API 주소
# 제가 생성한 file_scanner_api.py가 실행 중인 포트(10001)를 지정합니다.
SERVER_A_FILES_API_URL=http://gpusovitsapi.duckdns.org:10001
# 관리자 권한을 가질 구글 이메일 목록 (쉼표로 구분)
# 이 목록에 없는 이메일은 관리자 UI 및 API 접근이 차단됩니다.
ADMIN_EMAILS=user1@gmail.com,user2@gmail.com
# 기존 TTS API 주소 (동작 확인용)
TTS_BASE_URL=http://gpusovitsapi.duckdns.org:9880